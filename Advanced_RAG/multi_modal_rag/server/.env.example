NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://username:password@localhost:5432/rag_naive_rag
DATABASE_POOL_MAX=10

JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=7d

AUTH_COOKIE_NAME=rag_auth_token
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=localhost
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=5
CSRF_COOKIE_NAME=rag_csrf_token
CSRF_SECRET=replace-with-at-least-32-characters-csrf-secret

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=768
# Separate collection for CLIP image embeddings (different dimensionality).
QDRANT_IMAGE_COLLECTION=image_vectors
QDRANT_IMAGE_VECTOR_SIZE=512

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_LLM_MODEL=minimax-m2.5:cloud
# Vision-capable Ollama model used to answer questions grounded in retrieved images.
# Pull it first, e.g.: ollama pull llama3.2-vision
OLLAMA_VISION_MODEL=llama3.2-vision

# CLIP model (Transformers.js) used to embed images and text queries into a shared
# vector space. Weights (~250MB) download from Hugging Face on first use and are cached.
CLIP_MODEL=Xenova/clip-vit-base-patch32

RAG_TOP_K=5
# Max number of image sources retrieved per query.
RAG_IMAGE_TOP_K=3
RAG_UPLOAD_RATE_LIMIT_TTL_MS=60000
RAG_UPLOAD_RATE_LIMIT_LIMIT=5
RAG_CHAT_RATE_LIMIT_TTL_MS=60000
RAG_CHAT_RATE_LIMIT_LIMIT=30
RAG_STREAM_RATE_LIMIT_TTL_MS=60000
RAG_STREAM_RATE_LIMIT_LIMIT=10
RAG_RUNTIME_CONCURRENCY_LIMIT=4
