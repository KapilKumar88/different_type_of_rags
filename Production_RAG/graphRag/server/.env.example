NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://username:password@localhost:5432/rag_graph_rag
DATABASE_POOL_MAX=10

JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=7d

AUTH_COOKIE_NAME=rag_auth_token
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=localhost
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=5
CSRF_COOKIE_NAME=rag_csrf_token
CSRF_SECRET=replace-with-at-least-32-characters-csrf-secret

# Neo4j (start with: docker run -d --name neo4j-graphrag -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=minimax-m2.5:cloud

# Graph RAG settings
GRAPH_MAX_HOPS=2
GRAPH_ENTITY_SEED_LIMIT=5
GRAPH_NEIGHBOR_LIMIT=20
GRAPH_MAX_CONTEXT_CHARACTERS=6000
GRAPH_MAX_ENTITIES_PER_CHUNK=8
GRAPH_MAX_RELATIONSHIPS_PER_CHUNK=10

RAG_UPLOAD_RATE_LIMIT_TTL_MS=60000
RAG_UPLOAD_RATE_LIMIT_LIMIT=5
RAG_CHAT_RATE_LIMIT_TTL_MS=60000
RAG_CHAT_RATE_LIMIT_LIMIT=30
RAG_STREAM_RATE_LIMIT_TTL_MS=60000
RAG_STREAM_RATE_LIMIT_LIMIT=10
RAG_RUNTIME_CONCURRENCY_LIMIT=4
