NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://username:password@localhost:5432/rag_naive_rag
DATABASE_POOL_MAX=10

JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=7d

AUTH_COOKIE_NAME=rag_auth_token
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=localhost
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=5
CSRF_COOKIE_NAME=rag_csrf_token
CSRF_SECRET=replace-with-at-least-32-characters-csrf-secret

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=768

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_LLM_MODEL=minimax-m2.5:cloud

RAG_TOP_K=5
RAG_UPLOAD_RATE_LIMIT_TTL_MS=60000
RAG_UPLOAD_RATE_LIMIT_LIMIT=5
RAG_CHAT_RATE_LIMIT_TTL_MS=60000
RAG_CHAT_RATE_LIMIT_LIMIT=30
RAG_STREAM_RATE_LIMIT_TTL_MS=60000
RAG_STREAM_RATE_LIMIT_LIMIT=10
RAG_RUNTIME_CONCURRENCY_LIMIT=4

# Multi-Hop RAG
RAG_MULTI_HOP_ENABLED=true
RAG_MULTI_HOP_MAX_HOPS=4
RAG_MULTI_HOP_MAX_SUBQUESTIONS=3
RAG_MULTI_HOP_PER_HOP_TOP_K=4
RAG_MULTI_HOP_MAX_CONTEXT_CHUNKS=8
